# BeVigil App Enrichment - Environment Configuration
# Copy this file to .env and fill in your values

# BeVigil API
BEVIGIL_API_KEY='bivigil-api-key'

# Supabase — use Project URL and the new Secret API key (sb_secret_…), not legacy service_role JWT.
SUPABASE_URL='https://your-project.supabase.co'
SUPABASE_SECRET_KEY='sb_secret_...'

# Optional Configuration (defaults shown)
# BATCH_SIZE=10
# REQUEST_DELAY=1.5
# MAX_RETRIES=3
# REQUEST_TIMEOUT=30
